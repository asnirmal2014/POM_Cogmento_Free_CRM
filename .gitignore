# Maven build folder (contains compiled .class files and reports)
/target/

# TestNG generated output and emailable reports
/test-output/
emailable-report.html

# Log files
*.log
/logs/

# Eclipse IDE specific files and metadata
/.classpath
/.project
/.factorypath
/.settings/

# Exclude sensitive configuration files containing real tokens/passwords
src/test/resources/config.properties

# Security / Environment Variables (Additional safeguard)
*.env
*.pem

# Surefire / Failsafe plugins (Maven runner outputs)
/surefire-reports/

# Extent Reports / Allure Reports (If added in the future)
/test-output-report/
/ExtentReports/
/allure-results/
/allure-report/

# OS system files
.DS_Store
Thumbs.db

# OS-generated files (Additional)
*.tmp
*.bak
*.swp
